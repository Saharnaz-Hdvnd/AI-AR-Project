+        void ToggleHeadScan()
+        {
+            if(headScanActive) { StopHeadScan(); return; }
+            if(!ready || settings == null) { SetStatus("App is still starting."); return; }
+            if(string.IsNullOrWhiteSpace(settings.geminiApiKey) || string.IsNullOrWhiteSpace(settings.samToken)) {
+                SetStatus("Head scan needs the local Gemini key and SAM-2 endpoint/token."); return;
+            }
+            headScanCancellation=CancellationTokenSource.CreateLinkedTokenSource(lifetime.Token);
+            headScanActive=true; trackingTargetLabel=null;
+            SetStatus("Head-directed scan active. Aim the center of the view at a scooter part, screw, or tool. Press B to pause.");
+            _ = HeadTargetLoop(headScanCancellation.Token);
+        }
+        void StopHeadScan()
+        {
+            if(!headScanActive) return;
+            headScanActive=false; headScanCancellation?.Cancel();
+            SetStatus("Head-directed scan paused. Last spatial cue remains until the next step or scan.");
+        }
+        async Task HeadTargetLoop(CancellationToken cancel)
+        {
+            while(headScanActive && !cancel.IsCancellationRequested) {
+                try {
+                    if(busy) { await Task.Delay(200,cancel); continue; }
+                    busy=true;
+                    await ScanCenteredTarget(cancel);
+                } catch(OperationCanceledException) { break; }
+                  catch(Exception e) { SetStatus("Head scan: " + e.Message); }
+                finally { busy=false; }
+                try { await Task.Delay(Mathf.Max(250,Mathf.RoundToInt(settings.headScanPauseSeconds*1000)),cancel); }
+                catch(OperationCanceledException) { break; }
+            }
+        }
+        async Task ScanCenteredTarget(CancellationToken cancel)
+        {
+            SetStatus("Capturing the headset center view for target selection…");
+            FrameSnapshot frame=await Capture.Capture(settings,cancel,false);
+            // Do not leave the previous spatial mask hanging while a new target is found.
+            ClearCrop();
+            Detection detection=await RemoteClients.FindGazeTarget(frame,trackingTargetLabel,settings,cancel);
+            if(!detection.found) {
+                ClearCrop(); trackingTargetLabel=null;
+                SetStatus("No scooter part or tool centered. Aim at a target and scanning will retry.");
+                return;
+            }
+            string label=detection.label.Trim();
+            bool changed=!string.Equals(label,trackingTargetLabel,StringComparison.OrdinalIgnoreCase);
+            var step=new InstructionStep {
+                instruction=$"{label}: confirm the part and repair procedure in the scooter service manual before acting.",
+                phase="Find", display_label=label, visual_type=2,
+                key_components=new[]{label,"no movement"}
+            };
+            if(changed) speech?.Speak(step.instruction);
+            trackingTargetLabel=label;
+            SetStatus($"Center target: {label}. Requesting a fresh segmentation and spatial depth mesh…");
+            ClearCrop();
+            await SegmentAndPlace(step,frame,detection,cancel,false);
+            SetStatus($"Re-detected {label} and refreshed its depth-lifted 3D mask. Refresh speed depends on headset depth sampling and server latency; this is not a frame-rate video tracker.");
+        }
+        async Task SegmentAndPlace(InstructionStep step, FrameSnapshot frame, Detection detection, CancellationToken cancel, bool saveDebugArtifacts)
+        {
+            GameObject pending=null; Texture2D texture=null;
+            try {
+                pending=new GameObject("Scooter part spatial anchor");
+                pending.transform.SetPositionAndRotation(frame.CameraPose.position,frame.CameraPose.rotation);
+                var anchor=pending.AddComponent<OVRSpatialAnchor>();
+                float limit=Time.realtimeSinceStartup+8;
+                while(!anchor || !anchor.Localized) {
+                    cancel.ThrowIfCancellationRequested();
+                    if(!anchor || Time.realtimeSinceStartup>limit) throw new Exception("Spatial anchor could not localize. Check tracking and try again.");
+                    await Task.Yield();
+                }
+                SegmentResponse result=await RemoteClients.Segment(frame,detection,settings,cancel,SetStatus);
+                cancel.ThrowIfCancellationRequested();
+                if(Time.realtimeSinceStartup-frame.CapturedAt>settings.maxCaptureAgeSeconds) throw new Exception("Capture expired. Reacquire the target.");
+                byte[] cropPng=Convert.FromBase64String(result.png_base64);
+                texture=new Texture2D(2,2,TextureFormat.RGBA32,false);
+                if(!texture.LoadImage(cropPng) || texture.width!=result.crop_rect[2] || texture.height!=result.crop_rect[3]) throw new Exception("Invalid crop PNG.");
+                Capture.RefineDepthForMask(frame,result,texture,cancel,48);
+                CropGeometry.ApplyBlueTint(texture);
+                if(saveDebugArtifacts) await CaptureDebugLog.SaveCrop(frame,texture.EncodeToPNG());
+                var surface=CropGeometry.ProjectMaskToDepth(frame,result,texture);
+                for(int i=0;i<surface.Vertices.Length;i++) surface.Vertices[i]=pending.transform.InverseTransformPoint(surface.Vertices[i]);
+                if(!CropMaterial || !CropMaterial.shader || !CropMaterial.shader.isSupported) throw new Exception("Crop material/shader is missing or unsupported in this build.");
+                var mesh=new Mesh { name="Depth-lifted scooter segmentation" };
+                mesh.vertices=surface.Vertices; mesh.uv=surface.Uv; mesh.triangles=surface.Triangles; mesh.RecalculateNormals(); mesh.RecalculateBounds();
+                var crop=new GameObject("Scooter target 3D mask",typeof(MeshFilter),typeof(MeshRenderer));
+                crop.transform.SetParent(pending.transform,false); crop.GetComponent<MeshFilter>().sharedMesh=mesh;
+                var material=new Material(CropMaterial); material.mainTexture=texture; crop.GetComponent<MeshRenderer>().sharedMaterial=material;
+                pending.AddComponent<GuidanceVisual>().AddCropArrow(step,surface.Center,frame.CameraPose.rotation,surface.Width,CropMaterial);
+                ClearCrop(); cropRoot=pending; pending=null; cropTexture=texture; texture=null; cropMesh=mesh; cropMaterialInstance=material;
+                SetStatus($"3D mask built from {surface.Vertices.Length} depth samples and spatially anchored.");
+            } finally { if(pending) Destroy(pending); if(texture) Destroy(texture); }
+        }
